{
  "name": "garage",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "expo-constants": "17.1.8",
    "expo-linking": "7.1.7"
  },
  "devDependencies": {
    "expo-constants": "17.1.8",
    "expo-linking": "7.1.7"
  },
  "scripts": {
    "mobile": "npm run start --workspace=@garage/mobile",
    "api": "npm run start:dev --workspace=@garage/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
